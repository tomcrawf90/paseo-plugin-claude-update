{
  "name": "paseo-plugin-claude-update",
  "version": "0.2.1",
  "description": "Keeps the Claude Code CLI up to date on the Paseo host, where its own updater never runs, and shows which running agents are still on an old version.",
  "license": "MIT",
  "author": "Tom Crawford",
  "homepage": "https://github.com/tomcrawf90/paseo-plugin-claude-update#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomcrawf90/paseo-plugin-claude-update.git"
  },
  "bugs": {
    "url": "https://github.com/tomcrawf90/paseo-plugin-claude-update/issues"
  },
  "type": "module",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "claude-code",
    "auto-update",
    "automation"
  ],
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "CHANGELOG.md",
    "OVERVIEW.md",
    "!**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:listings": "node test/listing-check.mjs",
    "check:release": "node scripts/release.mjs check",
    "release:prepare": "node scripts/release.mjs prepare",
    "verify": "npm run typecheck && npm run test && npm run lint:listings && npm run check:release",
    "screenshots": "node scripts/screenshots.mjs",
    "check:compat": "node scripts/compat.mjs"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.10.3",
    "@tanstack/react-query": "^5.104.4",
    "@types/node": "^22.10.2",
    "@types/react": "~19.2.0",
    "puppeteer-core": "^24.43.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "semver": "^7.8.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "zod": "^4.6.7"
  }
}
