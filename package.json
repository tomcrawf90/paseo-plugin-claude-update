{
  "name": "paseo-plugin-claude-update",
  "version": "0.2.1",
  "description": "Paseo plugin: keeps the Claude Code CLI up to date on the daemon host, where its own updater never runs",
  "license": "MIT",
  "author": "Tom Crawford",
  "homepage": "https://github.com/tomcrawf90/paseo-plugin-claude-update#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomcrawf90/paseo-plugin-claude-update.git"
  },
  "bugs": {
    "url": "https://github.com/tomcrawf90/paseo-plugin-claude-update/issues"
  },
  "type": "module",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "claude-code",
    "auto-update",
    "automation"
  ],
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "CHANGELOG.md",
    "!**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:cafe": "node test/cafe-scan.mjs",
    "verify": "npm run typecheck && npm run test && npm run lint:cafe"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.10.3",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.10.2",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "zod": "^4.4.3"
  }
}
